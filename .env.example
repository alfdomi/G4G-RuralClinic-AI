# ────────────────────────────────────────────────────────────────────────────────
# Environment configuration for Docker Compose
# Copy this to .env and adjust values for your hardware.
#
# Usage:
#   cp .env.example .env
#   docker compose up --build
#
# ────────────────────────────────────────────────────────────────────────────────

# ── Quantized Model Selection ────────────────────────────────────────────────
# Choose from:
#   gemma4:e4b-q8_0    ~6 GB RAM  — highest quality (8-bit)
#   gemma4:e4b-q4_K_M  ~4 GB RAM  — best balance, RECOMMENDED (default)
#   gemma4:e4b-q4_0    ~3.8 GB RAM — lighter 4-bit
#   gemma4:e2b-q8_0    ~3 GB RAM  — lightweight (2B params)
#   gemma4:e2b-q4_K_M  ~2 GB RAM  — ultra-lightweight for constrained hardware
#
# On first run, the selected model will be pulled (~1–5 GB download).
#
QUANTIZED_MODEL=gemma4:e4b-q4_K_M

# ── Logging Level ────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
#
LOG_LEVEL=INFO

# ── Resource Limits (Docker Compose) ────────────────────────────────────────
# These are applied in docker-compose.yml deploy.resources sections.
# Override them in .env if your hardware differs.
#
# Total system RAM available:
#   - 8 GB laptop  → use gemma4:e4b-q4_K_M (default) or gemma4:e2b-*
#   - 4 GB laptop  → use gemma4:e2b-q4_K_M or gemma4:e2b-q8_0
#   - 16 GB laptop → you can use gemma4:e4b-q8_0 for better quality
#
# Ollama CPU cores limit:
OLLAMA_CPUS=2.0
# Ollama memory limit:
OLLAMA_MEMORY=4G

# App CPU and memory limits:
APP_CPUS=1.5
APP_MEMORY=3G

# ── Offline Mode ─────────────────────────────────────────────────────────────
# Keep this enabled for fully offline operation after model pull.
#
OFFLINE_MODE=true

# ── Ollama Configuration ────────────────────────────────────────────────────
# If you run Ollama on a different host, update this.
# Inside Docker, the app service connects to http://ollama:11434.
#
OLLAMA_HOST=http://ollama:11434

# ── Build Arguments ─────────────────────────────────────────────────────────
# Control which model is pulled during Docker image build.
# Set to "true" to skip model pull at build time (pull at runtime instead).
#
SKIP_MODEL_PULL=true
